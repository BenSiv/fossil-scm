fossil sql {
  INSERT INTO ai_note(
    tier,title,body,source_type,source_id,source_ref,process_level,metadata,
    artifact_weight,heat,retrieval_count,last_retrieved_at,content_hash,
    duplicate_of,merged_into,created_at,updated_at
  ) VALUES(
    3,'Knowledge Browser Concept','Materialized concept body for browser test.',
    'wiki',NULL,'Knowledge/Concept-A','atomic','{}',
    0.3,1.0,2,julianday('now'),'browser-concept-hash',
    NULL,NULL,julianday('now'),julianday('now')
  );
  INSERT INTO ai_note(
    tier,title,body,source_type,source_id,source_ref,process_level,metadata,
    artifact_weight,heat,retrieval_count,last_retrieved_at,content_hash,
    duplicate_of,merged_into,created_at,updated_at
  ) VALUES(
    2,'Storage Model Draft','Draft note body for browser doc link.',
    'doc',NULL,'doc/ai/STORAGE_MODEL.md','curated','{}',
    0.28,1.0,1,julianday('now'),'browser-draft-hash',
    NULL,NULL,julianday('now'),julianday('now')
  );
  INSERT INTO ai_retrieval(context_id,query_text,created_at)
  VALUES(NULL,'browser seeded retrieval',julianday('now'));
  INSERT INTO ai_retrieval_note(qid,nid,rank,score,tier_weight,reinforcement_delta)
  VALUES(
    (SELECT max(qid) FROM ai_retrieval),
    (SELECT nid FROM ai_note WHERE title='Knowledge Browser Concept' ORDER BY nid DESC LIMIT 1),
    1,0.95,0.8,0.2
  );
}

