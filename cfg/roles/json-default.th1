set thinking_tag [agent_config thinking_tag]
if {[string compare $thinking_tag ""] == 0} {set thinking_tag "thought"}

set system_prompt "You are the Fossil AI Agent. Provide concise, direct answers. Do not include chain-of-thought. If you need to reason, put it inside <$thinking_tag>...</$thinking_tag> and do not include it in the final answer."
set full_prompt "$system_prompt\n\nUser request:\n$msg"
set context ""
set retrieval_qid 0

if {$context_enabled} {
  set event_meta "{\"request_id\":\"$request_id\",\"stage\":\"context\",\"status\":\"running\"}"
  set event_msg "Assembling repository context..."
  agent_save_event $sid $user "progress" $provider $model $event_meta $event_msg
  set context [agent_context $msg $model]
  set retrieval_qid [agent_last_retrieval_qid]
  if {[string compare $context ""] != 0} {
    if {$retrieval_qid > 0} {
      set event_meta "{\"request_id\":\"$request_id\",\"stage\":\"context\",\"hidden\":true,\"retrieval_qid\":$retrieval_qid}"
    } else {
      set event_meta "{\"request_id\":\"$request_id\",\"stage\":\"context\",\"hidden\":true}"
    }
    agent_save_event $sid $user "context" $provider $model $event_meta $context
    set full_prompt "$system_prompt\n\nContext:\n$context\n\nUser request:\n$msg"
  }
  set event_meta "{\"request_id\":\"$request_id\",\"stage\":\"context\",\"status\":\"ok\"}"
  set event_msg "Repository context assembled"
  agent_save_event $sid $user "progress" $provider $model $event_meta $event_msg
}

set event_meta "{\"request_id\":\"$request_id\",\"tool\":\"chat-backend\",\"provider\":\"$provider\"}"
set event_msg "Invoking $provider backend"
agent_save_event $sid $user "tool" $provider $model $event_meta $event_msg
set event_meta "{\"request_id\":\"$request_id\",\"stage\":\"backend\",\"status\":\"running\"}"
set event_msg "Waiting for backend reply..."
agent_save_event $sid $user "progress" $provider $model $event_meta $event_msg

if {[string compare $context ""] != 0} {
  if {$retrieval_qid > 0} {
    set prompt_meta "{\"request_id\":\"$request_id\",\"context\":true,\"retrieval_qid\":$retrieval_qid}"
  } else {
    set prompt_meta "{\"request_id\":\"$request_id\",\"context\":true}"
  }
} else {
  set prompt_meta "{\"request_id\":\"$request_id\",\"context\":false}"
}
agent_save $sid $user "user" "prompt" $provider $model $prompt_meta $msg

if {[catch {agent_run $provider $model $full_prompt} reply]} {
  set event_meta "{\"request_id\":\"$request_id\",\"stage\":\"backend\",\"status\":\"error\"}"
  set event_msg "Backend reply failed"
  agent_save_event $sid $user "progress" $provider $model $event_meta $event_msg
  set acid [agent_save $sid $user "agent" "error" $provider $model "{\"request_id\":\"$request_id\"}" $reply]
  agent_eval $sid $acid $provider $model "error" $reply
  return "{\"error\":[agent_json_quote $reply]}"
}

set start_tag "<$thinking_tag>"
set end_tag "</$thinking_tag>"
set s [string first $start_tag $reply]
set e [string first $end_tag $reply]
set thinking ""
set clean_reply $reply
if {$s != -1} {
  if {$e != -1} {
    set s_end [expr {$s + [string length $start_tag]}]
    set thinking [string range $reply $s_end [expr {$e - 1}]]
    if {$s == 0} {
      set pre ""
    } else {
      set pre [string range $reply 0 [expr {$s - 1}]]
    }
    set post [string range $reply [expr {$e + [string length $end_tag]}] [expr {[string length $reply] - 1}]]
    if {[string length $pre] == 0} {
      set clean_reply $post
    } elseif {[string length $post] == 0} {
      set clean_reply $pre
    } else {
      set clean_reply "$pre $post"
    }
  }
}

set event_meta "{\"request_id\":\"$request_id\",\"stage\":\"backend\",\"status\":\"ok\"}"
set event_msg "Backend reply received"
agent_save_event $sid $user "progress" $provider $model $event_meta $event_msg

set meta "{\"request_id\":\"$request_id\"}"
set acid [agent_save $sid $user "agent" "reply" $provider $model $meta $clean_reply]
if {[string compare $thinking ""] != 0} {
  agent_save_reasoning $sid $acid $provider $model $thinking
}
agent_eval $sid $acid $provider $model "reply" $reply
return "{\"sid\":$sid,\"provider\":[agent_json_quote $provider],\"model\":[agent_json_quote $model],\"reply\":[agent_json_quote $clean_reply]}"
