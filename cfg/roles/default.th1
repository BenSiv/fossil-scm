set tools_json ""
set tools_path "cfg/mcp_tools.json"
catch { set tools_json [read_file $tools_path] }

set thinking_tag [agent_config thinking_tag]
if {[string compare $thinking_tag ""] == 0} {set thinking_tag "thought"}

set system_prompt "You are the Fossil AI Agent. You have access to the following tools:\n$tools_json\n\nTo use a tool, output: <tool_call>{\"name\":\"tool_name\",\"args\":{...}}</tool_call>\nIf you need to reason, put it inside <$thinking_tag>...</$thinking_tag> and do not include it in the final answer.\n"

set context ""
if {$context_enabled} {
  set context [agent_context $msg $model]
  if {[string compare $context ""] != 0} {
    # Collective Synthesis Phase
    if {[string first "Knowledge Graph Expansion" $context] != -1} {
       set synth_prompt "Consolidate the following repository context and knowledge graph expansion into a concise, unified briefing for the final reasoning step:\n\n$context"
       set context [agent_run $provider $model $synth_prompt]
    }
    set full_prompt "$system_prompt\nContext:\n$context\n\nUser request:\n$msg"
  } else {
    set full_prompt "$system_prompt\nUser request:\n$msg"
  }
} else {
  set full_prompt "$system_prompt\nUser request:\n$msg"
}

agent_save $sid $user "user" "prompt" $provider $model "" $msg

# Handle HITL Confirmation
if {[string compare [string range $msg 0 14] "CONFIRMED_EDIT:"] == 0} {
  set json [string range $msg 16 end]
  # Very simple field extraction for the prototype
  set path [agent_json_extract $json "path"]
  set replace [agent_json_extract $json "replace"]
  set with [agent_json_extract $json "with"]
  
  set res [agent_mcp_call edit_file $path "Applying approved edit" $replace $with 1]
  CX "data: [agent_json_quote $res]\n\n"
  agent_save $sid $user "agent" "reply" $provider $model "" $res
  return
}

# Main reasoning loop
if {[catch {agent_run_stream $provider $model $full_prompt} reply]} {
  CX "data: {\"error\":[agent_json_quote $reply]}\n\n"
  agent_save $sid $user "agent" "error" $provider $model "" $reply
} else {
  set start_tag "<$thinking_tag>"
  set end_tag "</$thinking_tag>"
  set s [string first $start_tag $reply]
  set e [string first $end_tag $reply]
  set thinking ""
  set clean_reply $reply
  if {$s != -1} {
    if {$e != -1} {
      set s_end [expr {$s + [string length $start_tag]}]
      set thinking [string range $reply $s_end [expr {$e - 1}]]
      if {$s == 0} {
        set pre ""
      } else {
        set pre [string range $reply 0 [expr {$s - 1}]]
      }
      set post [string range $reply [expr {$e + [string length $end_tag]}] [expr {[string length $reply] - 1}]]
      if {[string length $pre] == 0} {
        set clean_reply $post
      } elseif {[string length $post] == 0} {
        set clean_reply $pre
      } else {
        set clean_reply "$pre $post"
      }
    }
  }
  set acid [agent_save $sid $user "agent" "reply" $provider $model "" $clean_reply]
  if {[string compare $thinking ""] != 0} {
    agent_save_reasoning $sid $acid $provider $model $thinking
  }
}
